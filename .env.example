# Hermes Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# CORE SETTINGS
# =============================================================================

# JWT Secret Key - REQUIRED: Generate a secure random key
# Use: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_SECRET_KEY=your-secret-key-change-this-in-production

# Debug mode - Set to false in production
HERMES_DEBUG=false

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Host API port for docker-compose.dev.yml (internal API port remains 8000)
API_PORT=8000

# =============================================================================
# REVERSE PROXY CONFIGURATION
# =============================================================================

# Public nginx application port (production Compose)
HERMES_PORT=3000

# Development server port (Vite)
HERMES_DEV_PORT=5173

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection URL
# SQLite: sqlite+aiosqlite:///./data/hermes.db
# PostgreSQL: postgresql+asyncpg://hermes:password@database-host:5432/hermes
# See docs/POSTGRESQL.md for TLS, migrations, and disposable integration tests.
HERMES_DATABASE_URL=sqlite+aiosqlite:///./data/hermes.db

# Enable SQL query logging (development only)
HERMES_DATABASE_ECHO=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL for task queuing and caching
# Development: redis://localhost:6379
# Docker: redis://redis:6379
# Production: redis://redis:6379/0
HERMES_REDIS_URL=redis://redis:6379/0

# Select a Redis database with the URL suffix, for example /0.

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# Access token expiration (15 minutes default)
HERMES_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration (7 days default)
HERMES_REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT signing algorithm
HERMES_ALGORITHM=HS256

# =============================================================================
# SIGNUP CONTROL & INITIAL ADMIN
# =============================================================================

# Allow public user registration (default: false)
# When false, only admins can create user accounts
# For self-hosted deployments, set to false for security
HERMES_ALLOW_PUBLIC_SIGNUP=false

# Initial admin account (optional - created on first startup if no users exist)
# IMPORTANT: Remove or change these credentials after first login
# Leave empty to skip initial admin creation and use first-user-admin pattern
HERMES_INITIAL_ADMIN_USERNAME=
HERMES_INITIAL_ADMIN_EMAIL=
HERMES_INITIAL_ADMIN_PASSWORD=

# Example for Docker/production deployments:
# HERMES_INITIAL_ADMIN_USERNAME=admin
# HERMES_INITIAL_ADMIN_EMAIL=admin@example.com
# HERMES_INITIAL_ADMIN_PASSWORD=changeme123

# =============================================================================
# FILE STORAGE
# =============================================================================

# Directory for completed downloads, shared by the API and worker
# For Docker, use /app/downloads (the container mount path).
HERMES_DOWNLOAD_DIR=/app/downloads

# Temporary directory in Docker; use ./packages/hermes-api/temp locally.
HERMES_TEMP_DIR=/app/temp

# =============================================================================
# API KEYS & AUTHENTICATION
# =============================================================================

# Valid API keys (if using API key auth) - supports multiple formats:
# - Comma-separated: key1,key2,key3
# - JSON array: ["key1","key2","key3"]
# - Space-separated: key1 key2 key3
HERMES_API_KEYS=

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# Maximum requests per minute per IP
HERMES_RATE_LIMIT_PER_MINUTE=60

# Enable rate limiting
HERMES_ENABLE_RATE_LIMITING=true

# Maximum failed login attempts before lockout
HERMES_MAX_LOGIN_ATTEMPTS=5

# Time window for login attempt tracking (minutes)
HERMES_LOGIN_ATTEMPT_WINDOW_MINUTES=15

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS origins - supports multiple formats:
# - Comma-separated: http://localhost:3000,http://localhost:5173
# - JSON array: ["http://localhost:3000","http://localhost:5173"]
# - Space-separated: http://localhost:3000 http://localhost:5173
# Include your frontend domain(s) here
# Examples:
# - Development: http://localhost:3000,http://localhost:5173,http://localhost:8000
# - Single domain: https://hermes.example.com
# - Separate domains: https://hermes.example.com,https://hermes-api.example.com
HERMES_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,https://hermes.example.com,https://hermes-api.example.com

# Allow credentials in CORS requests
HERMES_ALLOW_CREDENTIALS=true

# =============================================================================
# SERVER-SENT EVENTS (SSE) CONFIGURATION
# =============================================================================

# Note: SSE is always enabled - it's a core requirement for Hermes
# Server-Sent Events provide real-time download progress and queue updates

# SSE heartbeat interval in seconds (keeps connection alive)
HERMES_SSE_HEARTBEAT_INTERVAL=30

# Maximum number of concurrent SSE connections
HERMES_SSE_MAX_CONNECTIONS=1000

# SSE connection timeout in seconds (5 minutes default)
HERMES_SSE_CONNECTION_TIMEOUT=300

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Exact published release shared by app, API, worker, and scheduler.
# Required only by docker-compose.example.yml. Use a release containing these
# Compose files; the old 0.6.0 images predate the opt-in retention safeguards.
# Leave empty when building the current checkout from source.
HERMES_IMAGE_TAG=

# =============================================================================
# FRONTEND BUILD CONFIGURATION
# =============================================================================

# API base URL. Production Docker reads it when the container starts;
# native Vite builds read it at build time.
# Examples:
# - Same domain: /api/v1
# - Separate domain: https://hermes-api.example.com/api/v1
# - Development: leave as /api/v1 (uses Docker proxy)
VITE_API_BASE_URL=/api/v1

# Note: SSE is always enabled in both frontend and backend
# No configuration variable needed - it's a core requirement for real-time updates

# Optional: delete managed terminal downloads older than this many days.
# Leave unset to retain media. Retention cleanup runs hourly when configured.
# HERMES_DOWNLOAD_RETENTION_DAYS=30

# Exact IPs or resolvable hostnames of trusted reverse proxies, comma-separated.
# Docker Compose defaults this to the frontend service name (app).
HERMES_TRUSTED_PROXY_HOSTS=
