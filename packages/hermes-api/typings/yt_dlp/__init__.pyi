from collections.abc import Iterable, Mapping
from types import TracebackType
from typing import Any, Self

from .networking import Request
from .networking.common import RequestDirector, RequestHandler, Response

class YoutubeDL:
    params: dict[str, Any]
    def __init__(
        self, params: Mapping[str, object] | None = ..., auto_init: bool = ...
    ) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
    def extract_info(
        self, url: str, download: bool = ..., **kwargs: object
    ) -> dict[str, Any] | None: ...
    def process_ie_result(
        self, result: dict[str, Any], download: bool = ...
    ) -> dict[str, Any]: ...
    def prepare_filename(self, info: dict[str, Any]) -> str: ...
    def build_request_director(
        self, handlers: Iterable[type[RequestHandler]], preferences: object = ...
    ) -> RequestDirector: ...
    def dl(
        self, name: str, info: dict[str, object], subtitle: bool = ..., test: bool = ...
    ) -> tuple[bool, bool]: ...
    def urlopen(self, request: str | Request) -> Response: ...
