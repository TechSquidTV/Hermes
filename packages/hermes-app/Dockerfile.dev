# Hermes App development server with the same workspace dependencies as CI.
FROM node:26-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/hermes-app/package.json ./packages/hermes-app/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile
COPY packages/hermes-app/ ./packages/hermes-app/
WORKDIR /app/packages/hermes-app
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
